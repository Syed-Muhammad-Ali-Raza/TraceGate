# Application
NODE_ENV=development
LOG_LEVEL=info

# Web (Next.js)
# Point at the API port you actually run (4000 default; 4010 if 4000 is busy).
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_PORT=3000

# API (Express)
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000
BODY_SIZE_LIMIT=1mb
PROXY_BODY_SIZE_LIMIT=10mb
TRUST_PROXY=false

# Auth (JWT + cookies) — replace with strong random values in production
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CSRF_SECRET=change-me-csrf-secret-min-32-chars!!!!

# Encryption for provider keys at rest (32-byte hex = 64 chars)
PROVIDER_KEY_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Set true to return local mock chat completions (no real provider key).
MOCK_LLM=false

# OpenAI-compatible upstream (paste that provider's key in the dashboard as "openai"):
#   OpenAI:     https://api.openai.com/v1
#   OpenRouter: https://openrouter.ai/api/v1   (models like openai/gpt-4o-mini, x-ai/grok-2)
#   xAI/Grok:   https://api.x.ai/v1            (models like grok-2-latest)
#   Groq:       https://api.groq.com/openai/v1 (models like llama-3.3-70b-versatile)
#   Ollama:     http://localhost:11434/v1
OPENAI_API_BASE=https://api.openai.com/v1
ANTHROPIC_API_BASE=https://api.anthropic.com

# PostgreSQL (host ports 15432/16379 avoid clashing with local installs)
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_USER=llmgateway
POSTGRES_PASSWORD=llmgateway
POSTGRES_DB=llmgateway
DATABASE_URL=postgresql://llmgateway:llmgateway@localhost:15432/llmgateway

# Redis
REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_URL=redis://localhost:16379
REDIS_PASSWORD=

# Worker
WORKER_CONCURRENCY=5
LOG_INGESTION_BATCH_SIZE=500
LOG_INGESTION_FLUSH_MS=1000

# Rate limits (defaults)
AUTH_RATE_LIMIT_POINTS=10
AUTH_RATE_LIMIT_DURATION_SECONDS=60
GLOBAL_RATE_LIMIT_POINTS=100
GLOBAL_RATE_LIMIT_DURATION_SECONDS=60
